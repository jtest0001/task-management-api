# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

# Neon POOLED endpoint (hostname contains "-pooler"). Used by the running server.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"
# Neon DIRECT endpoint (same host WITHOUT "-pooler"). Used only by the Prisma CLI
# (migrate/seed) — Prisma Migrate's advisory locks are unreliable through PgBouncer.
DIRECT_DB_URL="postgresql://user:password@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT="3000"
NODE_ENV="development"

JWT_ACCESS_SECRET="xxxxx"
JWT_REFRESH_SECRET="xxxxx"
REFRESH_TOKEN_COOKIE_NAME="refresh_token"

# Must be http(s). Normalised to a bare origin at boot (env.schema.ts) before the CORS config
# string-compares it against the browser's `Origin`, so a trailing slash, a default port, host
# casing, or a stray path are all tolerated.
FRONT_END_URL="http://localhost:5173"
REDIS_URL="rediss://default:password@xxxxx.upstash.io:6379"